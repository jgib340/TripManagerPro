<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:paddingTop="100dp"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <EditText
            android:id="@+id/titleInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Vacation Title" />

        <EditText
            android:id="@+id/hotelInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Hotel or Location"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/startDateInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Start Date (MM/dd/yyyy)"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/endDateInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="End Date (MM/dd/yyyy)"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/alertStartButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Alert: Start Date"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/alertEndButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Alert: End Date"
            android:layout_marginTop="10dp" />

        <Button
            android:id="@+id/excursionsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Manage Excursions"
            android:layout_marginTop="10dp" />

        <Button
            android:id="@+id/saveButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save"
            android:layout_marginTop="10dp" />

        <Button
            android:id="@+id/deleteButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Delete"
            android:layout_marginTop="10dp" />

        <Button
            android:id="@+id/shareButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Share"
            android:layout_marginTop="10dp" />

    </LinearLayout>

</ScrollView>